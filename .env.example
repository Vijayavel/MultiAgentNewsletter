# Copy to .env and fill in. Never commit .env.

# ---------- Writer agents (one key each) ----------
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# ---------- Review agent ----------
CEREBRAS_API_KEY=

# ---------- News search (the writers' shared source of current stories) ----------
# serper | brave
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=
# d = past day, w = past week
NEWS_FRESHNESS=d

# ---------- Newsletter ----------
# Publication name in the article masthead (the byline uses EMAIL_FROM_NAME)
NEWSLETTER_NAME=AI & Software Daily
# comma-separated
NEWSLETTER_TO=you@example.com
# send only if at least this many writers succeed
NEWSLETTER_MIN_WRITERS=2
NEWSLETTER_WORDS_MIN=600
NEWSLETTER_WORDS_MAX=750
# Sent-email history: repeat checks and the minimum gap between sends
NEWSLETTER_MIN_GAP_HOURS=12
NEWSLETTER_HISTORY_KEEP=2
NEWSLETTER_HISTORY_MAX_AGE_HOURS=48
# NEWSLETTER_HISTORY_FILE=newsletter_history.json
# Writers, search queries and every agent instruction are in config/agents.toml.
# NEWSLETTER_AGENTS_FILE=config/agents.toml

# ---------- Models (optional overrides; defaults shown) ----------
OPENAI_MODEL=gpt-5.4-mini
GOOGLE_MODEL=gemini-flash-latest
DEEPSEEK_MODEL=deepseek-flash
OPENROUTER_MODEL=qwen/qwen3.7-plus
CEREBRAS_MODEL=gpt-oss-120b
# <PROVIDER>_BASE_URL overrides an endpoint, e.g. OPENROUTER_BASE_URL=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3
# Extra waits (seconds) before retrying a busy or unreachable provider
LLM_RETRY_WAITS=10,30
# Go ahead with the writers that finished by then (if at least NEWSLETTER_MIN_WRITERS did)
WRITERS_DEADLINE_SECONDS=480

# ---------- Email (Gmail SMTP) ----------
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME="Content Agent"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# 16-character Gmail App Password, no spaces
SMTP_PASSWORD=

# ---------- Safety guardrails ----------
EMAIL_ALLOWED_RECIPIENTS=you@gmail.com
EMAIL_ALLOWED_DOMAINS=
EMAIL_MAX_PER_RUN=1
EMAIL_MAX_RECIPIENTS=5
# asks before sending; CI sets this to false
EMAIL_REQUIRE_APPROVAL=true
# true = log instead of sending (start here; set false once a --dry-run preview looks right)
EMAIL_DRY_RUN=true
